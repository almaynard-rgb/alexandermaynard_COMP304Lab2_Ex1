<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="regular_button">
        <item name="android:layout_width">130dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:backgroundTint">@color/dark_green</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="regular_text_view">
        <item name="android:layout_width">300dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="title_text">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/dark_green</item>
        <item name="android:textAlignment">center</item>
        <item name="layout_constraintVertical_bias">0.392</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="sub_title_text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAlignment">center</item>
        <item name="layout_constraintVertical_bias">0.492</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">400dp</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
    <style name="recycler_view_widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">400dp</item>
        <item name="layout_constraintVertical_bias">0.498</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="recycler_view_checkbox">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">0dp</item>
        <item name="layout_constraintVertical_bias">1.0</item>
        <item name="layout_constraintHorizontal_bias">1.0</item>
    </style>
    <style name="recycler_view_imageview">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="srcCompat">@color/black</item>
    </style>
    <style name="recycler_view_textview">
        <item name="android:layout_width">213dp</item>
        <item name="android:layout_height">120dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="layout_constraintHorizontal_bias">0.671</item>
    </style>
    <style name="radio_btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">50dp</item>
    </style>
    <style name="input_text_edittext">
        <item name="android:layout_width">400dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:lines">1</item>
        <item name="android:inputType">text</item>
    </style>
    <style name="input_number_edittext">
        <item name="android:layout_width">400dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:lines">1</item>
        <item name="android:inputType">text</item>
        <item name="android:ems">19</item>
        <item name="android:maxEms">19</item>
        <item name="android:minEms">16</item>
    </style>
</resources>