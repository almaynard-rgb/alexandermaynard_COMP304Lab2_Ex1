<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--Image view to show an image next to the description of the property (house, apartment or other)-->
    <ImageView
        android:id="@+id/house_recycler_view_image"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/house_image_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@color/black" />

    <!--To display all the relevant information about the property (house, apartment or other)-->
    <TextView
        android:id="@+id/house_type_row_textview"
        android:layout_width="213dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.671"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Checkbox so the user can select which house they would like as preferred-->
    <CheckBox
        android:id="@+id/house_type_row_checkbox"
        android:layout_width="48dp"
        android:layout_height="120dp"
        android:layout_marginEnd="4dp"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/house_type_row_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/house_type_row_textview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>