<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--Image view to show an image next to the description of the property (house, apartment or other)-->
    <ImageView
        android:id="@+id/house_recycler_view_image"
        style="@style/recycler_view_imageview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@string/house_image_placeholder"/>

    <!--To display all the relevant information about the property (house, apartment or other)-->
    <TextView
        android:id="@+id/house_type_row_textview"
        style="@style/recycler_view_textview"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Checkbox so the user can select which house they would like as preferred-->
    <CheckBox
        android:id="@+id/house_type_row_checkbox"
        style="@style/recycler_view_checkbox"
        app:layout_constraintBottom_toBottomOf="@+id/house_type_row_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/house_type_row_textview"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>