<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Townhouse">

    <!--Title for the activity-->
    <TextView
        android:id="@+id/townhouse_title"
        style="@style/title_text"
        android:text="@string/townhouse_title_text"
        app:layout_constraintBottom_toTopOf="@+id/house_type_recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Recyclerview to display the desired apartment list-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/house_type_recycler_view"
        style="@style/recycler_view_widget"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--Button to go to the checkout activity-->
    <Button
        android:id="@+id/townhouse_checkout_btn"
        style="@style/regular_button"
        android:text="@string/checkout_btn_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/house_type_recycler_view" />

</androidx.constraintlayout.widget.ConstraintLayout>